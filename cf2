
client = s3_client()
key = f"{PREFIX}/standard-test.txt"

try:
    put_url = client.generate_presigned_url(
        "put_object",
        Params={"Bucket": BUCKET, "Key": key},
        ExpiresIn=900,
        HttpMethod="PUT"
    )

    put_response = requests.put(
        put_url, data=TEST_DATA, timeout=30
    )

    record(
        "Standard S3 PUT",
        "PASS" if put_response.status_code == 200 else "FAIL",
        safe_host(put_url),
        f"HTTP {put_response.status_code}"
    )

    get_url = client.generate_presigned_url(
        "get_object",
        Params={"Bucket": BUCKET, "Key": key},
        ExpiresIn=900,
        HttpMethod="GET"
    )

    get_response = requests.get(get_url, timeout=30)

    success = (
        get_response.status_code == 200
        and get_response.content == TEST_DATA
    )

    record(
        "Standard S3 GET",
        "PASS" if success else "FAIL",
        safe_host(get_url),
        f"HTTP {get_response.status_code}; "
        f"Content verified={success}"
    )

except Exception as e:
    record("Standard S3", "FAIL", "N/A", type(e).__name__)
